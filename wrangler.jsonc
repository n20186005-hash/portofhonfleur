{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portofhonfleur",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "previews": {}
}
